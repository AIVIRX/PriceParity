        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這將刪除您儲存的 App Store Connect 憑證並清除此設備上的本地快取定價數據。"
          }
        },
        "bg" : {
          "stringUnit" : {
            "value" : "Това изтрива вашите запазени удостоверения за App Store Connect и изчиства локалните кеширани данни за цени на това устройство.",
