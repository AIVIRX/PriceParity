          "stringUnit" : {
            "state" : "translated",
            "value" : "આ તમારા સેવ કરેલ એપ સ્ટોર કનેક્ટ ક્રેડેંશિયલ્સને કાઢી નાખે છે અને આ ઉપકરણ પરની સ્થાનિક કેશ કરેલ ભાવ માહિતીને સાફ કરે છે."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini menghapus kredensial App Store Connect yang disimpan dan menghapus data harga yang disimpan secara lokal di perangkat ini."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies löscht Ihre gespeicherten App Store Connect-Anmeldeinformationen und leert die lokal zwischengespeicherten Preisdaten auf diesem Gerät."
          }
        },
        "cs" : {
          "stringUnit" : {
            "value" : "Tímto odstraníte své uložené přihlašovací údaje App Store Connect a vymažete místní vyrovnávací paměť cenových dat na tomto zařízení.",
            "state" : "translated"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "value" : "This deletes your saved App Store Connect credentials and clears the local cached pricing data on this device.",
            "state" : "translated"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "זה מוחק את האישורים ששמרת ב-App Store Connect ומנקה את נתוני המחירים המוקלטים המקומיים במכשיר זה."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tai ištrina jūsų išsaugotus App Store Connect prisijungimo duomenis ir išvalo vietinę talpyklą su kainų duomenimis šiame įrenginyje."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette sletter dine lagrede App Store Connect-legitimasjoner og tømmer den lokale bufrede prisdataene på denne enheten."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This deletes your saved App Store Connect credentials and clears the local cached pricing data on this device."
          }
        },
        "nl" : {
          "stringUnit" : {
            "value" : "Dit verwijdert je opgeslagen App Store Connect-inloggegevens en wist de lokale gecachte prijsgegevens op dit apparaat.",
            "state" : "translated"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бұл сіздің сақталған App Store Connect деректеріңізді жояды және осы құрылғыдағы жергілікті кэштелген баға деректерін тазалайды."
          }
        },
        "fi" : {
          "stringUnit" : {
            "value" : "Tämä poistaa tallennetut App Store Connect -tunnistetiedot ja tyhjentää tämän laitteen paikallisesti välimuistissa olevan hinnoittelutiedon.",
            "state" : "translated"
          }
        },
        "es-US" : {
          "stringUnit" : {
            "value" : "Esto elimina tus credenciales guardadas de App Store Connect y borra los datos de precios en caché locales en este dispositivo.",
            "state" : "translated"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso exclui suas credenciais salvas do App Store Connect e limpa os dados de preços em cache localmente neste dispositivo."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To izbriše vaše shranjene poverilnice App Store Connect in izbriše lokalne predpomnjene podatke o cenah na tem napravi."
          }
        }
      }
    },
