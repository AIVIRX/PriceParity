        "ur" : {
          "stringUnit" : {
            "value" : "آپ ڈیمو موڈ میں ہیں۔ اپنے ایپ اسٹور کنیکٹ API کلید سے جڑنے کے لیے اسناد پر ٹیپ کریں۔",
