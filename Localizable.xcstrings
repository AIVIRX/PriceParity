    "Removes saved App Store Connect credentials and locally cached pricing data from this device." : {
      "localizations" : {
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remove credenciais do App Store Connect salvas e dados de preços armazenados localmente deste dispositivo."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਇਸ ਡਿਵਾਈਸ ਤੋਂ ਸੇਵ ਕੀਤੇ ਐਪ ਸਟੋਰ ਕਨੈਕਟ ਪ੍ਰਮਾਣ ਪੱਤਰ ਅਤੇ ਸਥਾਨਕ ਤੌਰ 'ਤੇ ਕੈਸ਼ ਕੀਤੀ ਕੀਮਤ ਦੇ ਡਾਟਾ ਨੂੰ ਹਟਾਉਂਦਾ ਹੈ।"
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "value" : "Removes saved App Store Connect credentials and locally cached pricing data from this device.",
            "state" : "translated"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Removes saved App Store Connect credentials and locally cached pricing data from this device."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αφαιρεί τα αποθηκευμένα διαπιστευτήρια App Store Connect και τα τοπικά αποθηκευμένα δεδομένα τιμολόγησης από αυτή τη συσκευή."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اس ڈیوائس سے محفوظ کردہ ایپ اسٹور کنیکٹ کی اسناد اور مقامی طور پر کیش کردہ قیمتوں کے ڈیٹا کو ہٹا دیتا ہے۔"
          }
        },
        "da" : {
          "stringUnit" : {
            "value" : "Fjerner gemte App Store Connect legitimationsoplysninger og lokalt cachede prisdata fra denne enhed.",
            "state" : "translated"
          }
        },
        "hr" : {
          "stringUnit" : {
            "value" : "Uklanja spremljene akreditive App Store Connect i lokalno pohranjene podatke o cijenama s ovog uređaja.",
            "state" : "translated"
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime les identifiants App Store Connect enregistrés et les données de prix mises en cache localement de cet appareil."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഈ ഉപകരണത്തിൽ നിന്ന് സംരക്ഷിച്ച App Store Connect പ്രവേശനങ്ങൾക്കും പ്രാദേശികമായി കാഷെ ചെയ്ത വില ഡാറ്റക്കും നീക്കം ചെയ്യുന്നു."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menghapus kelayakan App Store Connect yang disimpan dan data harga yang disimpan secara tempatan dari peranti ini."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장된 App Store Connect 자격 증명 및 이 장치의 로컬 캐시된 가격 데이터를 제거합니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "value" : "Bu cihazdan kaydedilmiş App Store Connect kimlik bilgilerini ve yerel önbelleğe alınmış fiyat verilerini kaldırır.",
            "state" : "translated"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "value" : "從此設備中刪除已保存的 App Store Connect 憑證和本地緩存的定價數據。",
            "state" : "translated"
          }
        },
        "th" : {
          "stringUnit" : {
            "value" : "ลบข้อมูลประจำตัว App Store Connect ที่บันทึกไว้และข้อมูลราคาที่เก็บไว้ในเครื่องจากอุปกรณ์นี้",
            "state" : "translated"
          }
        },
        "ar" : {
          "stringUnit" : {
            "value" : "يتم إزالة بيانات اعتماد App Store Connect المحفوظة وبيانات التسعير المخزنة محليًا من هذا الجهاز.",
            "state" : "translated"
          }
        },
        "sk" : {
          "stringUnit" : {
            "value" : "Odstráni uložené poverenia App Store Connect a lokálne vyrovnané cenové údaje z tohto zariadenia.",
            "state" : "translated"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "value" : "從此設備中刪除已保存的 App Store Connect 憑證和本地緩存的定價數據。",
            "state" : "translated"
          }
        },
        "bg" : {
          "stringUnit" : {
            "value" : "Премахва запазените удостоверения на App Store Connect и локално кешираните данни за цени от това устройство.",
            "state" : "translated"
          }
        },
        "or" : {
          "stringUnit" : {
            "value" : "Fjerner lagrede App Store Connect-legitimasjoner og lokalt bufrede prisdata fra denne enheten.",
            "state" : "translated"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスから保存されたApp Store Connectの認証情報とローカルにキャッシュされた価格データを削除します。"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "या डिव्हाइसवरून जतन केलेले ऍप स्टोर कनेक्ट प्रमाणपत्रे आणि स्थानिक कॅश केलेले किंमत डेटा काढून टाका."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从此设备中删除保存的 App Store Connect 凭据和本地缓存的定价数据。"
