    "Add your API credentials so Price Parity can read your apps, territories, and prices. Create the key with the App Manager role." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "value" : "Legg til API-legitimasjonen din slik at Price Parity kan lese appene, områdene og prisene dine. Opprett nøkkelen med App Manager-rollen.",
            "state" : "translated"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನಿಮ್ಮ API ಪ್ರಮಾಣಪತ್ರಗಳನ್ನು ಸೇರಿಸಿ, ಇದರಿಂದ Price Parity ನಿಮ್ಮ ಅಪ್ಲಿಕೇಶನ್‌ಗಳನ್ನು, ಪ್ರದೇಶಗಳನ್ನು ಮತ್ತು ಬೆಲೆಯನ್ನು ಓದಬಹುದು. App Manager ಪಾತ್ರದೊಂದಿಗೆ ಕೀ ಅನ್ನು ರಚಿಸಿ."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "API деректеріңізді қосыңыз, сонда Price Parity сіздің қосымшаларыңызды, аумақтарыңызды және бағаларыңызды оқи алады. Кілтті App Manager рөлімен жасаңыз."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voeg uw API-inloggegevens toe zodat Price Parity uw apps, gebieden en prijzen kan lezen. Maak de sleutel aan met de rol App Manager."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügen Sie Ihre API-Anmeldeinformationen hinzu, damit Price Parity Ihre Apps, Gebiete und Preise lesen kann. Erstellen Sie den Schlüssel mit der Rolle App-Manager."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার এপিআই শংসাপত্র যোগ করুন যাতে প্রাইস প্যারিটি আপনার অ্যাপস, অঞ্চল এবং দাম পড়তে পারে। অ্যাপ ম্যানেজার ভূমিকা সহ কী তৈরি করুন।"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "value" : "Add your API credentials so Price Parity can read your apps, territories, and prices. Create the key with the App Manager role.",
            "state" : "translated"
          }
        },
        "cs" : {
          "stringUnit" : {
            "value" : "Přidejte své API přihlašovací údaje, aby Price Parity mohl číst vaše aplikace, území a ceny. Vytvořte klíč s rolí správce aplikací.",
            "state" : "translated"
          }
        },
        "ms" : {
          "stringUnit" : {
            "value" : "Tambah kelayakan API anda supaya Price Parity dapat membaca aplikasi, wilayah, dan harga anda. Cipta kunci dengan peranan Pengurus Aplikasi.",
            "state" : "translated"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agrega tus credenciales de API para que Price Parity pueda leer tus aplicaciones, territorios y precios. Crea la clave con el rol de Administrador de Aplicaciones."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambahkan kredensial API Anda agar Price Parity dapat membaca aplikasi, wilayah, dan harga Anda. Buat kunci dengan peran Manajer Aplikasi."
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agrega tus credenciales de API para que Price Parity pueda leer tus aplicaciones, territorios y precios. Crea la clave con el rol de Administrador de Aplicaciones."
          }
        },
        "ja" : {
          "stringUnit" : {
            "value" : "Price Parity がアプリ、地域、価格を読み取るために API 認証情報を追加してください。App Manager ロールでキーを作成します。",
            "state" : "translated"
          }
        },
        "gu" : {
          "stringUnit" : {
            "value" : "તમારા એપ્લિકેશનો, પ્રદેશો અને ભાવો વાંચવા માટે પ્રાઇસ પેરિટી તમારા એપીઆઈ ક્રેડેંશિયલ્સ ઉમેરો. એપ મેનેજર ભૂમિકા સાથે કી બનાવો.",
            "state" : "translated"
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "value" : "Add your API credentials so Price Parity can read your apps, territories, and prices. Create the key with the App Manager role.",
            "state" : "translated"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавете вашите API удостоверения, за да може Price Parity да чете вашите приложения, територии и цени. Създайте ключа с роля App Manager."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisää API-tunnistetietosi, jotta Price Parity voi lukea sovelluksesi, alueesi ja hinnat. Luo avain App Manager -roolilla."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione suas credenciais da API para que o Price Parity possa ler seus aplicativos, territórios e preços. Crie a chave com a função de Gerente de Aplicativos."
          }
        },
        "ur" : {
          "stringUnit" : {
            "value" : "اپنی API کی اسناد شامل کریں تاکہ Price Parity آپ کی ایپس، علاقوں، اور قیمتوں کو پڑھ سکے۔ ایپ منیجر کے کردار کے ساتھ کلید بنائیں۔",
            "state" : "translated"
          }
        },
        "sl" : {
          "stringUnit" : {
            "value" : "Dodajte svoje API poverilnice, da lahko Price Parity bere vaše aplikacije, ozemlja in cene. Ustvarite ključ z vlogo upravitelja aplikacij.",
            "state" : "translated"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加您的 API 憑證，以便 Price Parity 可以讀取您的應用程式、區域和價格。使用 App Manager 角色創建密鑰。"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiyat Eşitliği uygulamanızın uygulamalarını, bölgelerini ve fiyatlarını okuyabilmesi için API kimlik bilgilerinizi ekleyin. Anahtar, Uygulama Yöneticisi rolü ile oluşturulmalıdır."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägg till dina API-uppgifter så att Price Parity kan läsa dina appar, territorier och priser. Skapa nyckeln med rollen App Manager."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pridajte svoje API poverenia, aby mohol Price Parity čítať vaše aplikácie, územia a ceny. Vytvorte kľúč s rolou správcu aplikácií."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加您的 API 憑證，以便 Price Parity 可以讀取您的應用程式、區域和價格。使用 App Manager 角色創建密鑰。"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προσθέστε τα διαπιστευτήρια API σας ώστε το Price Parity να μπορεί να διαβάσει τις εφαρμογές, τις περιοχές και τις τιμές σας. Δημιουργήστε το κλειδί με τον ρόλο του Διαχειριστή Εφαρμογών."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавьте свои учетные данные API, чтобы Price Parity мог читать ваши приложения, территории и цены. Создайте ключ с ролью Менеджера приложений."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เพิ่มข้อมูลรับรอง API ของคุณเพื่อให้ Price Parity สามารถอ่านแอป ดินแดน และราคาได้ สร้างคีย์ด้วยบทบาทผู้จัดการแอป"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add your API credentials so Price Parity can read your apps, territories, and prices. Create the key with the App Manager role."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add meg az API hitelesítő adataidat, hogy a Price Parity olvasni tudja az alkalmazásaidat, területeidet és áraikat. Hozd létre a kulcsot az App Manager szerepkörrel."
          }
        },
        "ca" : {
          "stringUnit" : {
            "value" : "Afegeix les teves credencials de l'API perquè Price Parity pugui llegir les teves aplicacions, territoris i preus. Crea la clau amb el rol de Gestor d'Aplicacions.",
            "state" : "translated"
          }
        },
        "hi" : {
          "stringUnit" : {
            "value" : "अपने API क्रेडेंशियल्स जोड़ें ताकि प्राइस पैरिटी आपके ऐप्स, क्षेत्रों और कीमतों को पढ़ सके। ऐप प्रबंधक भूमिका के साथ कुंजी बनाएं।",
            "state" : "translated"
          }
        },
        "mr" : {
          "stringUnit" : {
            "value" : "आपले API क्रेडेन्शियल्स जोडा जेणेकरून प्राइस पॅरिटी आपल्या अॅप्स, प्रदेश आणि किंमती वाचू शकेल. अॅप मॅनेजर भूमिकेसह की तयार करा.",
            "state" : "translated"
          }
        },
        "pa" : {
          "stringUnit" : {
            "value" : "ਆਪਣੇ API ਪ੍ਰਮਾਣ ਪੱਤਰ ਜੋੜੋ ਤਾਂ ਜੋ Price Parity ਤੁਹਾਡੇ ਐਪਸ, ਖੇਤਰਾਂ ਅਤੇ ਕੀਮਤਾਂ ਨੂੰ ਪੜ੍ਹ ਸਕੇ। ਐਪ ਮੈਨੇਜਰ ਭੂਮਿਕਾ ਨਾਲ ਕੁੰਜੀ ਬਣਾਓ।",
            "state" : "translated"
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "പ്രൈസ് പാരിറ്റി നിങ്ങളുടെ ആപ്പുകൾ, പ്രദേശങ്ങൾ, വിലകൾ വായിക്കാൻ API ക്രെഡൻഷ്യലുകൾ ചേർക്കുക. ആപ്പ് മാനേജർ റോളുമായി കീ സൃഷ്ടിക്കുക."
          }
        },
        "he" : {
          "stringUnit" : {
            "value" : "הוסף את אישורי ה-API שלך כך ש-Price Parity יוכל לקרוא את האפליקציות, השטחים והמחירים שלך. צור את המפתח עם תפקיד מנהל האפליקציות.",
            "state" : "translated"
          }
        },
        "or" : {
          "stringUnit" : {
