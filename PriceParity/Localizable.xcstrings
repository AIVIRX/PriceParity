    "Add your API credentials so Price Parity can read your apps, territories, and prices. Create the key with the App Manager role." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف بيانات اعتماد API الخاصة بك حتى يتمكن Price Parity من قراءة تطبيقاتك وأراضيك وأسعارك. أنشئ المفتاح مع دور مدير التطبيق."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавете вашите API удостоверения, за да може Price Parity да чете вашите приложения, територии и цени. Създайте ключа с роля App Manager."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার এপিআই শংসাপত্র যোগ করুন যাতে প্রাইস প্যারিটি আপনার অ্যাপস, অঞ্চল এবং দাম পড়তে পারে। অ্যাপ ম্যানেজার ভূমিকা সহ কী তৈরি করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afegeix les teves credencials de l'API perquè Price Parity pugui llegir les teves aplicacions, territoris i preus. Crea la clau amb el rol de Gestor d'Aplicacions."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přidejte své API přihlašovací údaje, aby Price Parity mohl číst vaše aplikace, území a ceny. Vytvořte klíč s rolí správce aplikací."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilføj dine API-legitimationsoplysninger, så Price Parity kan læse dine apps, områder og priser. Opret nøglen med App Manager-rollen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügen Sie Ihre API-Anmeldeinformationen hinzu, damit Price Parity Ihre Apps, Gebiete und Preise lesen kann. Erstellen Sie den Schlüssel mit der Rolle App-Manager."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προσθέστε τα διαπιστευτήρια API σας ώστε το Price Parity να μπορεί να διαβάσει τις εφαρμογές, τις περιοχές και τις τιμές σας. Δημιουργήστε το κλειδί με τον ρόλο του Διαχειριστή Εφαρμογών."
          }
        },
        "en-AU" : {
