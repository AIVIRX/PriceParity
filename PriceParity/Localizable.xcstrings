    "This deletes your saved App Store Connect credentials and clears the local cached pricing data on this device." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا يحذف بيانات اعتماد App Store Connect المحفوظة وي clears بيانات التسعير المخزنة محليًا على هذا الجهاز."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Това изтрива вашите запазени удостоверения за App Store Connect и изчиства локалните кеширани данни за цени на това устройство."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
