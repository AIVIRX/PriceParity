    "Removes saved App Store Connect credentials and locally cached pricing data from this device." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم إزالة بيانات اعتماد App Store Connect المحفوظة وبيانات التسعير المخزنة محليًا من هذا الجهاز."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Премахва запазените удостоверения на App Store Connect и локално кешираните данни за цени от това устройство."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই ডিভাইস থেকে সংরক্ষিত অ্যাপ স্টোর সংযোগ প্রমাণপত্র এবং স্থানীয়ভাবে ক্যাশে করা মূল্য তথ্য মুছে ফেলুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina les credencials de l'App Store Connect desades i les dades de preus emmagatzemades localment d'aquest dispositiu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odstraní uložené přihlašovací údaje App Store Connect a místně uložená cenová data z tohoto zařízení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fjerner gemte App Store Connect legitimationsoplysninger og lokalt cachede prisdata fra denne enhed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entfernt gespeicherte App Store Connect-Anmeldeinformationen und lokal zwischengespeicherte Preisdaten von diesem Gerät."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αφαιρεί τα αποθηκευμένα διαπιστευτήρια App Store Connect και τα τοπικά αποθηκευμένα δεδομένα τιμολόγησης από αυτή τη συσκευή."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Removes saved App Store Connect credentials and locally cached pricing data from this device."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Removes saved App Store Connect credentials and locally cached pricing data from this device."
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Removes saved App Store Connect credentials and locally cached pricing data from this device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina las credenciales de App Store Connect guardadas y los datos de precios en caché localmente de este dispositivo."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina las credenciales de App Store Connect guardadas y los datos de precios en caché localmente de este dispositivo."
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina las credenciales de App Store Connect guardadas y los datos de precios en caché localmente de este dispositivo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poistaa tallennetut App Store Connect -tunnistetiedot ja paikallisesti välimuistissa olevat hinnoittelutiedot tästä laitteesta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime les identifiants App Store Connect enregistrés et les données de prix mises en cache localement de cet appareil."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime les identifiants App Store Connect enregistrés et les données de prix mises en cache localement de cet appareil."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "આ ઉપકરણમાંથી સાચવેલ એપ સ્ટોર કનેક્ટ પ્રમાણપત્રો અને સ્થાનિક રીતે કેશ કરેલ કિંમતોને દૂર કરે છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שחזר רכישות"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस डिवाइस से सहेजे गए ऐप स्टोर कनेक्ट क्रेडेंशियल्स और स्थानीय रूप से कैश की गई मूल्य निर्धारण डेटा को हटा देता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uklanja spremljene akreditive App Store Connect i lokalno pohranjene podatke o cijenama s ovog uređaja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eltávolítja a mentett App Store Connect hitelesítő adatokat és a helyben tárolt árképzési adatokat erről az eszközről."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menghapus kredensial App Store Connect yang disimpan dan data harga yang di-cache secara lokal dari perangkat ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimuove le credenziali salvate di App Store Connect e i dati di prezzo memorizzati localmente da questo dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
